<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- targetSdk 35 forces edge-to-edge on Android 15, which would draw the toolbar
         under the status bar. The layouts are not inset-aware yet, so opt out. -->
    <style name="Base.AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
